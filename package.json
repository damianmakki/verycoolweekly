{
  "name": "very-cool-weekly",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "An independent design and development newsletter, published from structured issue files.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "new:issue": "node scripts/new-issue.mjs",
    "web:stage": "node scripts/stage-website.mjs",
    "optimize": "node scripts/optimize-images.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "export:ruckus": "npm run build && npm run check && node scripts/export-ruckus.mjs",
    "social:plan": "node scripts/plan-x.mjs",
    "editorial": "node scripts/editorial-cli.mjs",
    "review": "node scripts/review-server.mjs",
    "preferences": "node scripts/preferences-cli.mjs",
    "sync:substack": "node scripts/sync-substack.mjs"
  },
  "devDependencies": {
    "cheerio": "^1.1.2",
    "sharp": "^0.35.5",
    "twitter-text": "^3.1.0"
  }
}
